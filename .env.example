# Copy to .env and fill in what you have. Nothing here is required for the offline demo.

# LLM team: OpenRouter (one key, many models; cost is reported per call)
# Key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
SPIKE_LLM_PROVIDER=openrouter
# Any OpenRouter model slug that supports tool calling, e.g.
#   anthropic/claude-sonnet-5   (default)
#   openai/gpt-5-mini           (cheaper, for exam reruns)
SPIKE_MODEL=anthropic/claude-sonnet-5

# Other providers instead (optional):
# SPIKE_LLM_PROVIDER=anthropic   + ANTHROPIC_API_KEY=
# SPIKE_LLM_PROVIDER=openai      + OPENAI_API_KEY=   (or GROQ_API_KEY with
#                                  SPIKE_LLM_BASE_URL=https://api.groq.com/openai/v1)
# Those don't report cost; set USD per million tokens for an estimate:
# SPIKE_PRICE_IN_PER_MTOK=
# SPIKE_PRICE_OUT_PER_MTOK=

# Generation by fuel type (free key: https://platform.openelectricity.org.au/)
OPENELECTRICITY_API_KEY=

# Price ($/MWh) that opens an investigation
SPIKE_THRESHOLD=300

# Retrieval embeddings: leave blank for the built-in hashing embedder,
# or set to minilm after: uv sync --extra embed
SPIKE_EMBEDDER=
